# Optional configuration for docker compose
# Copy this file to .env and adjust values as needed.

OPENCODE_IMAGE_NAME=opencode-ai:latest
OPENCODE_CONTAINER_NAME=opencode_container

OPENCODE_CONFIG_HOST_PATH=./data/config
OPENCODE_DATA_HOST_PATH=./data/local
OPENCODE_WORKSPACE_HOST_PATH=./workspace

OPENCODE_HOME=/home/ubuntu
OPENCODE_WORKDIR=/workspace
OPENCODE_PORT=4096
OPENCODE_HOST=0.0.0.0
OPENCODE_SERVER_PASSWORD=opencode
OPENCODE_SERVER_USERNAME=opencode
